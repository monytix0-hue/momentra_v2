{
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Momentra",
        "supportEmail": "resolvingpoint@gmail.com",
        "authorizedRedirectUris": [
          "http://localhost",
          "https://momentra-v2.firebaseapp.com/__/auth/handler",
          "https://momentra-v2.web.app/__/auth/handler"
        ]
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "momentra-v2",
    "public": "web/invite",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "**/README.md"
    ],
    "rewrites": [
      { "source": "/j/**", "destination": "/join.html" },
      { "source": "/join/**", "destination": "/join.html" },
      { "source": "/c/**", "destination": "/join.html" },
      { "source": "/company/**", "destination": "/join.html" }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "source": "/apple-app-site-association",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      }
    ]
  }
}
