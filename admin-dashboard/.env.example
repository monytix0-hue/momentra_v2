# Public API origin for production builds of this dashboard (no trailing path).
# Dev uses the Vite proxy instead — leave unused when running npm run dev.
VITE_API_BASE_URL=https://api.example.com

# LOCAL DEV ONLY. Vite embeds VITE_* into the JS bundle — never put a real production
# ADMIN_API_KEY here for a hosted/public build. Prefer pasting the key on the login screen
# (sessionStorage). In production builds, VITE_ADMIN_API_KEY is ignored by the app.
VITE_ADMIN_API_KEY=