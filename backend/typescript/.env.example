# Momentra API — local / Dokploy
PORT=3000
NODE_ENV=development

# Firebase (leave unset for dev bypass via X-Dev-Firebase-Uid header)
FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Identity namespace for UUIDv5(user_id)
MOMENTRA_UUID_NAMESPACE=a1b2c3d4-e5f6-7890-abcd-ef1234567890

# PostgreSQL (Supabase pooler + direct 5432 for migrations)
DATABASE_URL=postgresql://momentra_app:password@localhost:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres:password@localhost:5432/postgres
# Pool: max connections; min = startup prewarm (default 2 — do not set high without measuring idle pressure)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

CORS_ORIGINS=http://localhost:3000
SCHEMA_RELEASE=V001-V040

# Redis / BullMQ (optional — core commands work without Redis)
REDIS_URL=redis://127.0.0.1:6379

# Supabase Storage (media signed uploads — same project as DATABASE_URL)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=your-service-role-or-secret-key
# MEDIA_BUCKET=momentra-media

# Observability (optional)
SENTRY_DSN=

# Feature flags JSON object
FEATURE_FLAGS={}
