{
  "name": "momentra-api",
  "version": "1.0.0",
  "description": "Momentra sync control plane — Architecture v4",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:install": "tsx scripts/migrate.ts --install-only",
    "migrate:repair": "tsx scripts/migrate.ts --install-only --repair-legacy",
    "migrate:validate": "tsx scripts/migrate.ts --validation-only",
    "migrate:reset": "tsx scripts/reset-database.ts --confirm",
    "migrate:full": "tsx scripts/reset-database.ts --confirm && tsx scripts/migrate.ts",
    "test:db": "tsx scripts/db-phase1-tests.ts",
    "openapi:build": "tsx scripts/build-openapi.ts",
    "openapi:bundle": "tsx scripts/bundle-openapi.ts",
    "openapi:validate": "tsx scripts/openapi-validate.ts",
    "openapi:generate": "npm run openapi:build && npm run openapi:bundle && npm run openapi:generate-kotlin && npm run openapi:generate-swift",
    "openapi:generate-kotlin": "powershell -ExecutionPolicy Bypass -File scripts/generate-kotlin.ps1",
    "openapi:generate-swift": "powershell -ExecutionPolicy Bypass -File scripts/generate-swift.ps1",
    "openapi:coverage": "tsx scripts/route-coverage.ts",
    "test:platform": "tsx --test tests/platform-foundation.test.ts tests/runtime-parity.test.ts",
    "worker:outbox": "tsx ../workers/outbox-dispatcher/src/index.ts",
    "worker:projection": "tsx ../workers/projection-worker/src/index.ts",
    "worker:notification": "tsx ../workers/notification-worker/src/index.ts",
    "worker:scheduler": "tsx ../workers/scheduler/src/index.ts",
    "worker:analytics": "tsx ../workers/analytics-worker/src/index.ts",
    "worker:memory": "tsx ../workers/memory-worker/src/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "qa:ensure-maestro-user": "tsx scripts/ensure-maestro-user.ts",
    "qa:reset-fixtures": "tsx scripts/qa/reset-maestro-fixtures.ts",
    "qa:seed-fixtures": "tsx scripts/qa/seed-maestro-fixtures.ts",
    "qa:prepare-fixtures": "tsx scripts/qa/prepare-maestro-fixtures.ts",
    "qa:verify-finance": "tsx scripts/qa/verify-maestro-finance.ts",
    "qa:build-catalog": "tsx scripts/qa/build-certification-catalog.ts",
    "qa:build-input-catalog": "tsx scripts/qa/build-input-catalog.ts",
    "qa:sync-ledger-data": "tsx scripts/qa/sync-ledger-maestro-data.ts",
    "qa:generate-input-flows": "tsx scripts/qa/generate-input-flows.ts",
    "qa:generate-certification-report": "tsx scripts/qa/generate-certification-report.ts",
    "qa:verify-ledger-batch": "tsx scripts/qa/verify-ledger-batch.ts",
    "qa:run-certification-waves": "tsx scripts/qa/run-certification-waves.ts",
    "qa:reconcile-ledger-math": "tsx scripts/qa/reconcile-ledger-math.ts",
    "qa:validate-wave-artifacts": "tsx scripts/qa/validate-wave-artifacts.ts",
    "qa:record-backend-checkpoint": "tsx scripts/qa/record-backend-checkpoint.ts",
    "audit:deployment": "python3 scripts/audit/run-deployment-audit.py",
    "audit:supplemental": "python3 scripts/audit/run-supplemental-audit.py",
    "audit:reaudit-v3": "python3 scripts/audit/run-reaudit-v3.py",
    "audit:remediation-dashboard": "python3 scripts/audit/remediation-dashboard.py",
    "audit:apply-remediation": "python3 scripts/audit/apply-remediation-status.py && python3 scripts/audit/classify-remediation-artifacts.py && python3 scripts/audit/remediation-dashboard.py",
    "qa:verify": "tsx scripts/qa/verify-maestro-cert.ts",
    "qa:generate-flows": "tsx scripts/qa/generate-cert-flows.ts",
    "qa:generate-reports": "tsx scripts/qa/generate-certification-reports.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "@sentry/node": "^10.71.0",
    "@supabase/supabase-js": "^2.112.4",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.2.2",
    "cors": "^2.8.6",
    "decimal.js": "^10.5.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "tsx": "^4.23.12",
    "uuid": "^14.0.2",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.13",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "yaml": "^2.8.1"
  }
}
