PORT=3000
DATABASE_URL=
DATABASE_URL_DIRECT=

# Supabase — Postgres pooler (DATABASE_URL) + Storage (media uploads)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional: client publishable key (not used by backend storage; APK/iOS may use separately)
# SUPABASE_PUBLISHABLE_KEY=
# Storage bucket name (default: momentra-media; auto-created on first upload if missing)
MEDIA_BUCKET=momentra-media

# Production (Dokploy): NODE_ENV=production, ALLOW_DEV_AUTH=0, GOVERNANCE_FAIL_OPEN=0
ALLOW_DEV_AUTH=0
FIREBASE_PROJECT_ID=momentra-v2
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional: client web API key for scripts/ensure-maestro-user.ts REST fallback
# FIREBASE_WEB_API_KEY=
GOVERNANCE_FAIL_OPEN=0
SCHEMA_RELEASE=V001-V056
MOMENTRA_IDENTITY_NAMESPACE=a1b2c3d4-e5f6-7890-abcd-ef1234567890
CORS_ORIGINS=http://localhost:3000
# Compose overrides Redis to redis://redis:6379 inside Dokploy
REDIS_URL=redis://127.0.0.1:6379
SENTRY_DSN=
FEATURE_FLAGS={}
MOMENTRA_AI_INTERNAL_KEY=