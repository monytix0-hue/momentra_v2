    "sectionSmall": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": 16, "lineHeight": 20, "letterSpacing": 0, "textCase": "none", "iosRelativeTo": "headline" }, "$extensions": { "figma": "section card title 16/700 (v12 pulse cards)" } },
    "bodyStrong": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": 14, "lineHeight": 18, "letterSpacing": 0, "textCase": "none", "iosRelativeTo": "body" }, "$extensions": { "figma": "list row title 14/700" } },
    "body": { "$type": "typography", "$value": { "fontWeight": 400, "fontSize": 14, "lineHeight": 18, "letterSpacing": 0, "textCase": "none", "iosRelativeTo": "body" }, "$extensions": { "figma": "body 14/400" } },
    "labelStrong": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": 13, "lineHeight": 16, "letterSpacing": 0, "textCase": "none", "iosRelativeTo": "subheadline" } },
    "label": { "$type": "typography", "$value": { "fontWeight": 500, "fontSize": 13, "lineHeight": 16, "letterSpacing": 0, "textCase": "none", "iosRelativeTo": "subheadline" } },
    "metaStrong": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": 12, "lineHeight": 15, "letterSpacing": 0, "textCase": "none", "iosRelativeTo": "caption" }, "$extensions": { "figma": "chip label 12/700" } },
    "meta": { "$type": "typography", "$value": { "fontWeight": 500, "fontSize": 12, "lineHeight": 15, "letterSpacing": 0, "textCase": "none", "iosRelativeTo": "caption" }, "$extensions": { "figma": "metadata 12/500" } },
    "caption": { "$type": "typography", "$value": { "fontWeight": 400, "fontSize": 11, "lineHeight": 14, "letterSpacing": 0, "textCase": "none", "iosRelativeTo": "caption2" } },
    "eyebrow": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": 11, "lineHeight": 14, "letterSpacing": 0.6, "textCase": "uppercase", "iosRelativeTo": "caption2" }, "$extensions": { "figma": "HARBOR MART · ANDHERI 11/700 uppercase" } },
    "micro": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": 10, "lineHeight": 13, "letterSpacing": 0.6, "textCase": "uppercase", "iosRelativeTo": "caption2" } },
    "tiny": { "$type": "typography", "$value": { "fontWeight": 500, "fontSize": 8, "lineHeight": 11, "letterSpacing": 0.12, "textCase": "none", "iosRelativeTo": "caption2" } },
    "button": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": 15, "lineHeight": 19, "letterSpacing": 0, "textCase": "none", "iosRelativeTo": "callout" }, "$extensions": { "figma": "\"Start this store\" 15/700" } },
    "chip": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": 12, "lineHeight": 15, "letterSpacing": 0, "textCase": "none", "iosRelativeTo": "caption" } },
    "metric": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": 20, "lineHeight": 25, "letterSpacing": -0.2, "textCase": "none", "iosRelativeTo": "title3" }, "$extensions": { "figma": "metric value 20/700" } },
    "metricSmall": { "$type": "typography", "$value": { "fontWeight": 700, "fontSize": 16, "lineHeight": 20, "letterSpacing": 0, "textCase": "none", "iosRelativeTo": "headline" } }
  }
}
