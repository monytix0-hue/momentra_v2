# Copy to .env.maestro.local (gitignored). Never commit secrets.
#
# Provision + seed fixtures from the backend:
#   cd backend/typescript
#   $env:QA_FIXTURES_ENABLED="true"; $env:ALLOW_DEV_AUTH="1"
#   npm run qa:prepare-fixtures
#
# Or single user only:
#   npm run qa:ensure-maestro-user
# Needs FIREBASE_SERVICE_ACCOUNT_JSON (Admin) or FIREBASE_WEB_API_KEY /
# apk/app/google-services.json for Identity Toolkit fallback.

# Legacy / smoke default (seed sets this to QA_MULTI_CONTEXT if empty)
MAESTRO_EMAIL=
MAESTRO_PASSWORD=

# Run token for finance notes: MAESTRO-${MAESTRO_RUN_ID}
MAESTRO_RUN_ID=

# Dedicated QA identities (defaults applied by seed if blank)
QA_EMPTY_EMAIL=
QA_EMPTY_PASSWORD=

QA_PERSONAL_EMAIL=
QA_PERSONAL_PASSWORD=

QA_GROUP_OWNER_EMAIL=
QA_GROUP_OWNER_PASSWORD=

QA_GROUP_MEMBER_EMAIL=
QA_GROUP_MEMBER_PASSWORD=

QA_GROUP_OUTSIDER_EMAIL=
QA_GROUP_OUTSIDER_PASSWORD=

QA_BUSINESS_OWNER_EMAIL=
QA_BUSINESS_OWNER_PASSWORD=

QA_BUSINESS_MEMBER_EMAIL=
QA_BUSINESS_MEMBER_PASSWORD=

QA_BUSINESS_OUTSIDER_EMAIL=
QA_BUSINESS_OUTSIDER_PASSWORD=

QA_MULTI_CONTEXT_EMAIL=
QA_MULTI_CONTEXT_PASSWORD=

# ---------------------------------------------------------------------------
# S9-QA-C — Platform-isolated certification accounts
# Android (APK) and iOS never share these during platform certification.
# Defaults: qa.apk.personal@test.com / qa.ios.personal@test.com / …
# ---------------------------------------------------------------------------

QA_APK_PERSONAL_EMAIL=
QA_APK_PERSONAL_PASSWORD=
QA_APK_GROUP_OWNER_EMAIL=
QA_APK_GROUP_OWNER_PASSWORD=
QA_APK_GROUP_MEMBER_EMAIL=
QA_APK_GROUP_MEMBER_PASSWORD=
QA_APK_GROUP_OUTSIDER_EMAIL=
QA_APK_GROUP_OUTSIDER_PASSWORD=
QA_APK_BUSINESS_OWNER_EMAIL=
QA_APK_BUSINESS_OWNER_PASSWORD=
QA_APK_BUSINESS_MEMBER_EMAIL=
QA_APK_BUSINESS_MEMBER_PASSWORD=
QA_APK_BUSINESS_OUTSIDER_EMAIL=
QA_APK_BUSINESS_OUTSIDER_PASSWORD=

QA_IOS_PERSONAL_EMAIL=
QA_IOS_PERSONAL_PASSWORD=
QA_IOS_GROUP_OWNER_EMAIL=
QA_IOS_GROUP_OWNER_PASSWORD=
QA_IOS_GROUP_MEMBER_EMAIL=
QA_IOS_GROUP_MEMBER_PASSWORD=
QA_IOS_GROUP_OUTSIDER_EMAIL=
QA_IOS_GROUP_OUTSIDER_PASSWORD=
QA_IOS_BUSINESS_OWNER_EMAIL=
QA_IOS_BUSINESS_OWNER_PASSWORD=
QA_IOS_BUSINESS_MEMBER_EMAIL=
QA_IOS_BUSINESS_MEMBER_PASSWORD=
QA_IOS_BUSINESS_OUTSIDER_EMAIL=
QA_IOS_BUSINESS_OUTSIDER_PASSWORD=

# Optional PIN for app-lock flows
QA_APP_LOCK_PIN=135790

# Shared default password used by seed when per-alias password blank
# QA_DEFAULT_PASSWORD=MaestroQa123
